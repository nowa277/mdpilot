source leaprc.protein.ff19SB
source leaprc.water.opc3
mol = loadPDB /home/user/obsidian/project/MDPilot/tests/test_output/2cab/2CAB_cleaned_pdb4amber.pdb

# Protonation state assignments
set mol.36 name "HIE"
set mol.60 name "HID"
set mol.63 name "HID"
set mol.90 name "HID"
set mol.92 name "HID"
set mol.99 name "HIE"
set mol.103 name "HID"
set mol.115 name "HID"
set mol.118 name "HIE"
set mol.196 name "HID"
set mol.239 name "HIE"

solvateOct mol OPC3BOX 10.0
addIons mol Cl- 0
addIons mol Na+ 0
saveAmberParm mol /home/user/obsidian/project/MDPilot/tests/test_output/2cab/system.prmtop /home/user/obsidian/project/MDPilot/tests/test_output/2cab/system.inpcrd
quit