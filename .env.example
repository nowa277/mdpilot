# MDPilot Environment Configuration Template
# Copy this file to .env and fill in your actual values
# Note: .env is gitignored and should never be committed

# ============================================================================
# Database Configuration
# ============================================================================
# PostgreSQL connection URL
# Format: postgresql+asyncpg://username:password@host:port/database
# MDPILOT_DATABASE_URL=postgresql+asyncpg://mdpilot:your_password@localhost:5432/mdpilot

# ============================================================================
# LLM Provider Configuration
# ============================================================================
# Anthropic API key for Claude models
# MDPILOT_API_KEY=sk-ant-...

# Optional: Custom API base URL (for proxy or alternative endpoints)
# MDPILOT_BASE_URL=https://api.anthropic.com

# Optional: Model selection (defaults to claude-sonnet-4-20250514)
# MDPILOT_MODEL=claude-sonnet-4-20250514

# ============================================================================
# AMBER Simulation Configuration (if using molecular dynamics features)
# ============================================================================
# Path to AMBER installation directory
# AMBER_HOME=/opt/amber26

# ============================================================================
# Development Settings
# ============================================================================
# Set to true to enable SQL query logging
# MDPILOT_DATABASE_ECHO=false
